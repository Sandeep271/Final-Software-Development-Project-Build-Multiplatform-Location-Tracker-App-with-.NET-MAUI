<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LocationHeatMapApp.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
    BackgroundColor="White">

    <Grid RowDefinitions="52,*,Auto">
        <!-- Header styled to resemble the assignment's sample layout. -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource PrimaryColor}">
            <Label
                Text="MainView"
                TextColor="White"
                FontSize="18"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Grid>

        <maps:Map
            x:Name="LocationMap"
            Grid.Row="1"
            IsShowingUser="True"
            MapType="Street" />

        <Border
            Grid.Row="2"
            BackgroundColor="{StaticResource SurfaceColor}"
            Stroke="#E5E7EB"
            StrokeThickness="1"
            Padding="12,10">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <Button
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Start Tracking"
                        Clicked="OnStartClicked" />
                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="Stop"
                        Clicked="OnStopClicked" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="Refresh Map"
                        Clicked="OnRefreshClicked" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="Clear History"
                        Clicked="OnClearClicked" />
                </Grid>

                <Label
                    x:Name="StatusLabel"
                    Text="Ready. Tap Start Tracking to record your route."
                    TextColor="{StaticResource TextColor}"
                    FontSize="12"
                    LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
